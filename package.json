{
  "name": "@ryangarber/markitdown-ts",
  "version": "0.1.2",
  "description": "Convert various file formats to Markdown for indexing, text analysis, and other applications that benefit from structured text. Node-free fork of the TypeScript fork of the original Python library.",
  "keywords": [
    "markdown",
    "converter",
    "browser",
    "uint8array",
    "docx",
    "pdf",
    "xlsx",
    "zip"
  ],
  "homepage": "https://github.com/ryangarber/markitdown-ts#readme",
  "bugs": {
    "url": "https://github.com/ryangarber/markitdown-ts/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ryangarber/markitdown-ts.git"
  },
  "license": "MIT",
  "author": "Ryan Garber",
  "contributors": [
    "Vaibhav Raj"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsdown",
    "check": "biome check . && tsc --noEmit",
    "check:fix": "biome check --write .",
    "format": "biome format --write .",
    "lint": "biome lint .",
    "prepublishOnly": "npm run check && npm test -- --run && npm run build",
    "release": "bumpp --commit --push --tag && pnpm publish",
    "test": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@joplin/turndown-plugin-gfm": "^1.0.67",
    "@xmldom/xmldom": "^0.9.11",
    "fflate": "^0.8.3",
    "linkedom": "^0.18.13",
    "mammoth": "^1.12.1",
    "turndown": "^7.2.4",
    "unpdf": "^1.8.1",
    "exceljs": "^4.4.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.9",
    "@types/turndown": "^5.0.6",
    "bumpp": "^12.2.1",
    "tsdown": "^0.22.14",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "packageManager": "pnpm@11.22.0+sha512.1ff870c4c6133dfd88fb2afc46dd13d47f09c9794b438c6fdb47ca98caf3bc16381ee0be93a091b8e3824cf01f889f46d7d9e20910fb0be1ab0fb5baa80dd621"
}
